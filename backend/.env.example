# Copiar este archivo como .env y completar los valores. El archivo .env no se sube al repositorio.

# Conexión a PostgreSQL: usuario, contraseña, servidor, puerto y base de datos.
DATABASE_URL=postgresql+psycopg://cbp_app:CONTRASENA_DE_CBP_APP@localhost:5432/control_biometrico

# Clave para firmar las sesiones. Usar una cadena larga y aleatoria, distinta en cada instalación.
# Se puede generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Duración de la sesión en minutos (480 = 8 horas).
JWT_MINUTOS=480

# Direcciones desde donde se abre el frontend, separadas por coma.
ORIGENES_CORS=http://localhost:5173

# Bloqueo de cuentas por intentos fallidos de inicio de sesión.
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=15
